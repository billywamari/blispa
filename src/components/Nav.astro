---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.jpg";

const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/team", label: "Team" },
  { href: "/gallery", label: "Gallery" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-gold-800/40 bg-ink/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Blispa Barbershop & Spa" width={56} height={56} class="h-12 w-12 rounded-full object-cover ring-1 ring-gold-500/60" />
      <span class="font-display text-lg leading-tight tracking-wide text-cream">
        Blispa <span class="text-gold-gradient block text-xs font-sans font-semibold uppercase tracking-[0.2em]">Barbershop &amp; Spa</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-sm font-medium uppercase tracking-wide transition-colors hover:text-gold-300",
            current === link.href ? "text-gold-400" : "text-cream/80",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="https://app.podium.co.ke/book/BFRPL1313"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-full bg-gradient-to-r from-gold-500 to-gold-300 px-5 py-2 text-sm font-semibold text-ink shadow-lg shadow-gold-900/30 transition-transform hover:scale-105 md:inline-block"
    >
      Book Now
    </a>

    <button
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-md p-2 text-cream md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-gold-800/40 bg-ink px-5 pb-4 md:hidden">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          "rounded px-2 py-3 text-sm font-medium uppercase tracking-wide",
          current === link.href ? "text-gold-400" : "text-cream/80",
        ]}
      >
        {link.label}
      </a>
    ))}
    <a
      href="https://app.podium.co.ke/book/BFRPL1313"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-2 rounded-full bg-gradient-to-r from-gold-500 to-gold-300 px-5 py-2.5 text-center text-sm font-semibold text-ink"
    >
      Book Now
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isHidden));
    menu?.classList.toggle("flex");
  });
</script>
