---
interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  class?: string;
  /** All clips in this card's group, so tapping opens a swipeable fullscreen playlist starting here. */
  playlist: { src: string; poster: string; label: string }[];
  index: number;
}

const { poster, label, class: className, playlist, index } = Astro.props;
---

<div
  class:list={["group relative overflow-hidden rounded-2xl border border-gold-800/30 bg-graphite", className]}
  data-fsv-group
  data-fsv-playlist={JSON.stringify(playlist)}
>
  <button type="button" data-fsv-open data-fsv-index={index} class="block h-full w-full cursor-pointer text-left" aria-label={`Play video: ${label}`}>
    <img
      src={poster.src}
      loading="lazy"
      decoding="async"
      alt={label}
      class="aspect-[9/16] h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
    <div class="pointer-events-none absolute bottom-0 left-0 right-0 p-4">
      <p class="font-display text-sm text-cream">{label}</p>
    </div>
    <div class="pointer-events-none absolute right-3 top-3 rounded-full bg-ink/60 p-2 opacity-90 backdrop-blur transition-opacity group-hover:opacity-70">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-gold-300">
        <path d="M8 5v14l11-7z" />
      </svg>
    </div>
  </button>
</div>
