---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Row { name: string; time?: string; price: string; }
interface Block { h2: string; paras: string[]; }
interface Faq { q: string; a: string; }
interface Link { href: string; label: string; }

interface Props {
  title: string;
  description: string;
  kicker: string;
  h1: string;
  h1Gold: string;
  hook: string;
  intro: string;
  image: ImageMetadata;
  imageAlt: string;
  serviceName: string;
  priceLow?: number;
  priceHigh?: number;
  prices?: Row[];
  priceNote?: string;
  blocks: Block[];
  faqs: Faq[];
  related: Link[];
  waText: string;
  gallery?: ImageMetadata[];
  galleryAlt?: string;
}

const p = Astro.props;
const SITE = "https://www.blispabarbershop.co.ke";
const pageUrl = new URL(Astro.url.pathname.replace(/\/?$/, "/"), SITE).href;
const wa = `https://wa.me/254746200969?text=${encodeURIComponent(`${p.waText} (from ${pageUrl})`)}`;
const book = "https://app.podium.co.ke/book/BFRPL1313";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: p.serviceName,
      serviceType: p.serviceName,
      url: pageUrl,
      areaServed: { "@type": "City", name: "Nairobi" },
      provider: { "@id": `${SITE}/#business` },
      ...(p.priceLow && p.priceHigh
        ? { offers: { "@type": "AggregateOffer", priceCurrency: "KES", lowPrice: p.priceLow, highPrice: p.priceHigh } }
        : {}),
    },
    {
      "@type": "FAQPage",
      mainEntity: p.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: p.serviceName, item: pageUrl },
      ],
    },
  ],
};
---

<Layout title={p.title} description={p.description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="mx-auto max-w-6xl px-5 pb-8 pt-14 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-xs text-cream/50">
      <a href="/" class="hover:text-gold-300">Home</a> <span class="mx-1">/</span> <span>{p.serviceName}</span>
    </nav>
    <div class="mt-6 grid items-center gap-10 md:grid-cols-2">
      <div>
        <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-400">{p.kicker}</p>
        <h1 class="mt-4 font-display text-4xl font-semibold leading-tight text-cream md:text-5xl">
          {p.h1} <span class="text-gold-gradient">{p.h1Gold}</span>
        </h1>
        <p class="mt-5 text-lg font-medium text-gold-200">{p.hook}</p>
        <p class="mt-3 leading-relaxed text-cream/70">{p.intro}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-[#1E9E50] px-6 py-3 text-sm font-semibold text-white shadow-lg transition-transform hover:scale-105">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Chat on WhatsApp
          </a>
          <a href={book} target="_blank" rel="noopener noreferrer" class="rounded-full border border-gold-500/60 px-6 py-3 text-sm font-semibold text-gold-200 transition-colors hover:bg-gold-500/10">Book a time</a>
          <a href="tel:+254746200969" class="rounded-full border border-cream/20 px-6 py-3 text-sm font-semibold text-cream/80 transition-colors hover:border-gold-500/60">Call 0746 200 969</a>
        </div>
        <p class="mt-5 text-sm text-cream/60"><span class="text-gold-300">&#9733;&#9733;&#9733;&#9733;&#9733;</span> Rated 4.9 on Google &middot; Superior Centre, Kenyatta Avenue</p>
      </div>
      <div class="overflow-hidden rounded-2xl border border-gold-800/30">
        <Image src={p.image} alt={p.imageAlt} width={900} height={675} class="aspect-[4/3] w-full object-cover" loading="eager" />
      </div>
    </div>
  </section>

  {p.prices && p.prices.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 py-10">
      <h2 class="font-display text-2xl font-semibold text-cream md:text-3xl">Prices at Blispa</h2>
      <div class="mt-6 overflow-hidden rounded-2xl border border-gold-800/30 bg-graphite">
        <table class="w-full text-left text-sm">
          <thead class="bg-charcoal text-xs uppercase tracking-wider text-gold-400">
            <tr><th class="px-4 py-3">Service</th><th class="px-4 py-3">Time</th><th class="px-4 py-3 text-right">Price</th></tr>
          </thead>
          <tbody class="divide-y divide-gold-800/20">
            {p.prices.map((r) => (
              <tr><td class="px-4 py-3 text-cream">{r.name}</td><td class="px-4 py-3 text-cream/60">{r.time ?? ""}</td><td class="px-4 py-3 text-right font-semibold text-gold-200">{r.price}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-cream/50">{p.priceNote ?? "Prices can change. Send a WhatsApp message and we confirm your exact price before you come in."}</p>
    </section>
  )}


  {p.gallery && p.gallery.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 py-6">
      <div class="grid grid-cols-3 gap-3">
        {p.gallery.map((g, i) => (
          <div class="overflow-hidden rounded-xl border border-gold-800/30">
            <Image src={g} alt={`${p.galleryAlt ?? p.serviceName} at Blispa, photo ${i + 1}`} width={500} height={500} class="aspect-square w-full object-cover" />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-10">
    <h2 class="font-display text-2xl font-semibold text-cream md:text-3xl">How booking works</h2>
    <ol class="mt-6 grid gap-4 md:grid-cols-3">
      <li class="rounded-2xl border border-gold-800/30 bg-graphite p-6"><span class="font-display text-2xl text-gold-400">1</span><p class="mt-2 font-semibold text-cream">Message us</p><p class="mt-1 text-sm text-cream/60">Tap WhatsApp and say what you want and when.</p></li>
      <li class="rounded-2xl border border-gold-800/30 bg-graphite p-6"><span class="font-display text-2xl text-gold-400">2</span><p class="mt-2 font-semibold text-cream">Get your price</p><p class="mt-1 text-sm text-cream/60">We confirm the price and hold a chair for you.</p></li>
      <li class="rounded-2xl border border-gold-800/30 bg-graphite p-6"><span class="font-display text-2xl text-gold-400">3</span><p class="mt-2 font-semibold text-cream">Walk in and relax</p><p class="mt-1 text-sm text-cream/60">4th Floor, Room K1. Coffee or juice while you wait.</p></li>
    </ol>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-10">
    {p.blocks.map((b) => (
      <div class="mt-10 first:mt-0">
        <h2 class="font-display text-2xl font-semibold text-cream md:text-3xl">{b.h2}</h2>
        {b.paras.map((t) => <p class="mt-4 leading-relaxed text-cream/70">{t}</p>)}
      </div>
    ))}
  </section>

  <section class="border-y border-gold-800/30 bg-charcoal py-14">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="font-display text-2xl font-semibold text-cream md:text-3xl">Questions people ask</h2>
      <div class="mt-6 space-y-3">
        {p.faqs.map((f) => (
          <details class="group rounded-xl border border-gold-800/30 bg-graphite px-5 py-4 open:border-gold-600/50">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-cream">
              {f.q}
              <span class="text-gold-400 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-cream/70">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <h2 class="font-display text-xl text-gold-300">Also at Blispa</h2>
    <div class="mt-5 flex flex-wrap gap-3">
      {p.related.map((l) => (
        <a href={l.href} class="rounded-full border border-gold-800/40 bg-graphite px-5 py-2.5 text-sm text-cream/80 transition-colors hover:border-gold-500/60 hover:text-gold-200">{l.label}</a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 text-center">
    <h2 class="font-display text-2xl font-semibold text-cream md:text-3xl">Ready when you are</h2>
    <p class="mx-auto mt-3 max-w-md text-cream/65">Superior Centre, 4th Floor, Room K1, Kenyatta Avenue, Nairobi CBD. Message us and we hold a chair for you.</p>
    <a href={wa} target="_blank" rel="noopener noreferrer" class="mt-7 inline-block rounded-full bg-[#1E9E50] px-8 py-3.5 text-sm font-semibold text-white shadow-lg transition-transform hover:scale-105">Chat on WhatsApp</a>
  </section>
  <div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-gold-800/40 bg-ink/95 p-3 backdrop-blur md:hidden">
    <a href={wa} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-full bg-[#1E9E50] py-3 text-center text-sm font-semibold text-white">WhatsApp</a>
    <a href="tel:+254746200969" class="flex-1 rounded-full border border-gold-500/60 py-3 text-center text-sm font-semibold text-gold-200">Call</a>
  </div>
  <div class="h-16 md:hidden"></div>
</Layout>
