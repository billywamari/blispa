---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import interior02 from "../assets/gallery/interior-02.jpg";
import gallery05 from "../assets/gallery/gallery-05.jpg";
import gallery08 from "../assets/gallery/gallery-08.jpg";
import gallery06 from "../assets/gallery/gallery-06.jpg";
import gallery07 from "../assets/gallery/gallery-07.jpg";
import gallery11 from "../assets/gallery/gallery-11.jpg";
import fade03 from "../assets/gallery/fade-03.jpg";
import pedicure01 from "../assets/gallery/pedicure-01.jpg";

const values = [
  {
    title: "Skilled Hands",
    copy: "Every barber and therapist here trained before they touched a paying client's hair. That's not a marketing line — it's the reason a fade at Blispa looks the same whichever chair you end up in. No rushed cuts, no guesswork, no \"let's see how this goes.\"",
  },
  {
    title: "Relaxed Atmosphere",
    copy: "Gold-lit mirrors, plush seating and a pace that never feels rushed. We schedule enough time between clients that your appointment doesn't start with an apology about running late.",
  },
  {
    title: "One Roof, Every Need",
    copy: "From a clean fade to a full spa pedicure — grooming and self-care live together at Blispa, which means the visit you almost didn't have time for can actually cover everything on your list.",
  },
];

const timeline = [
  {
    year: "The Idea",
    copy: "Nairobi had plenty of good barbershops and plenty of good spas — but almost nowhere that respected both. Blispa started as a simple frustration: why does getting a fresh cut and taking care of your skin, nails, and shoulders require two separate trips across town?",
  },
  {
    year: "The Space",
    copy: "We picked the 4th floor of Superior Centre on Kenyatta Avenue because it's central without being chaotic — easy to find, easy to park near, and quiet enough once you're inside that the street noise disappears. Every mirror, chair and light fixture was chosen to make the room feel like somewhere you'd want to sit for an hour, not just five minutes.",
  },
  {
    year: "The Standard",
    copy: "We built the team around one rule: if you wouldn't get it done on your own head or feet, don't offer it to a client. That rule still runs the shop today — from the straight razors we keep sharpened to the pedicure water we keep at the right temperature.",
  },
];
---

<Layout title="About" description="Blispa Barbershop & Spa is Nairobi's grooming and self-care lounge at Superior Centre, Kenyatta Avenue.">
  <section class="mx-auto max-w-6xl px-5 pb-6 pt-16 md:pt-24">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        <p class="font-display text-sm uppercase tracking-[0.35em] text-gold-400">Our Story</p>
        <h1 class="mt-4 font-display text-4xl font-semibold text-cream md:text-5xl">
          More than a barbershop — <span class="text-gold-gradient">a self-care ritual.</span>
        </h1>
        <p class="mt-6 leading-relaxed text-cream/70">
          Blispa Barbershop &amp; Spa was built around a simple idea: looking sharp and feeling good shouldn't
          require two different appointments. Tucked on the 4th floor of Superior Centre on Kenyatta Avenue,
          we bring together precision barbering and spa-grade self-care in one gold-and-black space designed
          to slow you down for an hour.
        </p>
        <p class="mt-4 leading-relaxed text-cream/70">
          Whether you're in for a straight-razor lineup, a set of fresh locs, or a full pedicure and massage,
          our team treats every chair like the only one in the room. We're not trying to move you through fast
          — we're trying to send you out looking like you had the whole day to prepare, even if you only had
          an hour.
        </p>
        <p class="mt-4 leading-relaxed text-cream/70">
          That philosophy shows up in small ways: the barber who double-checks your lineup in a second mirror
          before handing you a third, the therapist who asks about pressure before she starts a massage instead
          of guessing, the receptionist who remembers your name by your second visit. None of it is an
          accident. It's just what happens when a shop is built by people who actually care whether you come back.
        </p>
      </div>
      <div class="overflow-hidden rounded-2xl border border-gold-800/30">
        <Image src={interior02} alt="Blispa Barbershop & Spa interior" width={800} height={1000} class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Timeline / how we got here -->
  <section class="border-y border-gold-800/30 bg-charcoal py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-2xl">
        <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-400">How We Got Here</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-cream md:text-4xl">From an idea to a floor full of chairs</h2>
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {timeline.map((t) => (
          <div class="border-t border-gold-800/40 pt-6">
            <p class="font-display text-sm uppercase tracking-[0.25em] text-gold-500">{t.year}</p>
            <p class="mt-4 leading-relaxed text-cream/65">{t.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <div class="max-w-2xl">
      <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-400">What We Stand For</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-cream md:text-4xl">The Blispa standard</h2>
      <p class="mt-5 leading-relaxed text-cream/65">
        A standard only means something if you can feel it the moment you sit down. Here's what we hold
        ourselves to on every single visit, not just the ones where we're trying to make a good first impression.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {values.map((v) => (
        <div class="rounded-2xl border border-gold-800/30 bg-graphite p-7">
          <h3 class="font-display text-lg text-gold-300">{v.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/65">{v.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Photo band -->
  <section class="border-y border-gold-800/30 bg-charcoal py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-xl">
        <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-400">A Look Around</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-cream md:text-4xl">The space, as it actually looks</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="aspect-[4/3] overflow-hidden rounded-2xl lg:col-span-2">
          <Image src={gallery05} alt="Inside Blispa Barbershop & Spa" width={900} height={675} class="h-full w-full object-cover" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-2xl">
          <Image src={gallery08} alt="Inside Blispa Barbershop & Spa" width={500} height={375} class="h-full w-full object-cover" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-2xl">
          <Image src={gallery06} alt="Inside Blispa Barbershop & Spa" width={500} height={375} class="h-full w-full object-cover" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-2xl">
          <Image src={pedicure01} alt="Spa pedicure station at Blispa" width={500} height={375} class="h-full w-full object-cover" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-2xl">
          <Image src={fade03} alt="Fresh fade at Blispa" width={500} height={375} class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Neighborhood -->
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <div class="order-2 grid grid-cols-2 gap-4 md:order-1">
        <div class="aspect-[3/4] overflow-hidden rounded-2xl">
          <Image src={gallery07} alt="Blispa Barbershop & Spa" width={500} height={666} class="h-full w-full object-cover" />
        </div>
        <div class="mt-8 aspect-[3/4] overflow-hidden rounded-2xl">
          <Image src={gallery11} alt="Blispa Barbershop & Spa" width={500} height={666} class="h-full w-full object-cover" />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-400">Right In The City Centre</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-cream md:text-4xl">Easy to reach, easy to return to</h2>
        <p class="mt-5 leading-relaxed text-cream/65">
          We're on the 4th floor of Superior Centre, right at the corner of Kenyatta Avenue and Moi Avenue —
          close enough to town that you can pop in on a lunch break, and calm enough once you're upstairs that
          it doesn't feel like you're still in the middle of the CBD.
        </p>
        <p class="mt-4 leading-relaxed text-cream/65">
          Most of our regulars are people who work nearby and started coming in "just this once" before a big
          meeting or event — and then kept coming back because nowhere else matched the combination of skill,
          pace and price. That's really the whole pitch: come once for a reason, come back because it's simply
          the better haircut.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 text-center md:py-20">
    <h2 class="font-display text-2xl font-semibold text-cream md:text-3xl">Come see us</h2>
    <p class="mx-auto mt-3 max-w-md text-cream/65">
      Superior Centre, 4th Floor Room K1, Kenyatta Avenue &amp; Moi Avenue, Nairobi.
    </p>
    <a
      href="/contact"
      class="mt-7 inline-block rounded-full border border-gold-500/60 px-8 py-3.5 text-sm font-semibold text-cream transition-colors hover:border-gold-300 hover:text-gold-300"
    >
      Get Directions &amp; Contact Info
    </a>
  </section>
</Layout>
