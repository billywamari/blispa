---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import VideoCard from "../components/VideoCard.astro";
import posterSatisfaction from "../assets/video-posters/satisfaction.jpg";
import posterBold from "../assets/video-posters/bold-color.jpg";
import posterTeamIntro from "../assets/video-posters/team-intro.jpg";
import posterLocationIntro from "../assets/video-posters/location-intro.jpg";
import posterBehindTheChair from "../assets/video-posters/behind-the-chair.jpg";
import posterGroomed from "../assets/video-posters/groomed-to-perfection.jpg";
import posterSpaLounge from "../assets/video-posters/spa-lounge.jpg";
import posterShaveStyle from "../assets/video-posters/straight-razor-shave.jpg";
import posterTwistStyle from "../assets/video-posters/twist-style.jpg";
import posterBobCut from "../assets/video-posters/precision-bob-cut.jpg";
import posterMeetTeam from "../assets/video-posters/meet-the-team.jpg";

const imageModules = import.meta.glob("../assets/gallery/*.jpg", { eager: true });
const sorted = Object.entries(imageModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => (mod as { default: ImageMetadata }).default);

const reactionClips = [
  { src: "/videos/satisfaction.mp4", poster: posterSatisfaction, label: "Satisfaction Guaranteed" },
  { src: "/videos/straight-razor-shave.mp4", poster: posterShaveStyle, label: "Straight Razor Lineup" },
  { src: "/videos/bold-color.mp4", poster: posterBold, label: "Let's Go Bold" },
  { src: "/videos/precision-bob-cut.mp4", poster: posterBobCut, label: "Precision Bob Cut" },
  { src: "/videos/team-intro.mp4", poster: posterTeamIntro, label: "Maureen & JP" },
  { src: "/videos/twist-style.mp4", poster: posterTwistStyle, label: "Twist Out Styling" },
  { src: "/videos/meet-the-team.mp4", poster: posterMeetTeam, label: "Say Hi to the Front Desk" },
  { src: "/videos/location-intro.mp4", poster: posterLocationIntro, label: "Superior Centre, 4th Floor" },
  { src: "/videos/behind-the-chair.mp4", poster: posterBehindTheChair, label: "Behind the Chair" },
  { src: "/videos/groomed-to-perfection.mp4", poster: posterGroomed, label: "Groomed to Perfection" },
  { src: "/videos/spa-lounge.mp4", poster: posterSpaLounge, label: "The Spa Lounge" },
];
const reactionPlaylist = reactionClips.map((c) => ({ src: c.src, poster: c.poster.src, label: c.label }));
---

<Layout title="Gallery" description="See real cuts, shaves, locs and spa work from Blispa Barbershop & Spa in Nairobi.">
  <section class="mx-auto max-w-6xl px-5 pb-6 pt-16 text-center md:pt-24">
    <p class="font-display text-sm uppercase tracking-[0.35em] text-gold-400">Our Work</p>
    <h1 class="mt-4 font-display text-4xl font-semibold text-cream md:text-5xl">
      The <span class="text-gold-gradient">Gallery</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-cream/65">
      No stock photography, no borrowed inspiration boards pulled off Pinterest. Every image below is a real
      client who sat in a real chair at Blispa — the fades, the beard lineups, the locs, the pedicures, all of
      it shot the same day the work was finished. If you're trying to picture what you'll look like walking out
      of here, this is the most honest preview we can give you.
    </p>
  </section>

  <!-- Client reaction clips -->
  <section class="mx-auto max-w-6xl px-5 pb-4">
    <div class="max-w-2xl">
      <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-400">Straight From The Chair</p>
      <h2 class="mt-3 font-display text-2xl font-semibold text-cream md:text-3xl">Straight from the chair, unscripted</h2>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
      {reactionClips.map((clip, i) => (
        <VideoCard src={clip.src} poster={clip.poster} label={clip.label} playlist={reactionPlaylist} index={i} />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="columns-2 gap-4 sm:columns-3 [&>*]:mb-4">
      {sorted.map((img) => (
        <div class="break-inside-avoid overflow-hidden rounded-xl border border-gold-800/20">
          <Image
            src={img}
            alt="Blispa Barbershop & Spa"
            width={600}
            height={600}
            class="w-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- What to look for -->
  <section class="border-y border-gold-800/30 bg-charcoal py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-2xl">
        <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-400">What To Notice</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-cream md:text-4xl">The details we're proud of</h2>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-gold-800/30 bg-graphite p-7">
          <h3 class="font-display text-lg text-gold-300">The Line-Ups</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/65">Look closely at the edges around the temples and hairline — that crisp, almost drawn-on precision is what a straight razor finish actually looks like, not a clipper guard shortcut.</p>
        </div>
        <div class="rounded-2xl border border-gold-800/30 bg-graphite p-7">
          <h3 class="font-display text-lg text-gold-300">The Fade Blend</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/65">No harsh lines where the fade meets the top — just a smooth gradient that took multiple passes at different guard lengths to get right.</p>
        </div>
        <div class="rounded-2xl border border-gold-800/30 bg-graphite p-7">
          <h3 class="font-display text-lg text-gold-300">The Locs & Braids</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/65">Even parting, consistent tension, and a finish that lies flat from day one instead of needing a week to settle.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 text-center md:py-20">
    <h2 class="font-display text-2xl font-semibold text-cream md:text-3xl">Want to see yourself here?</h2>
    <p class="mx-auto mt-3 max-w-md leading-relaxed text-cream/65">
      Send us a photo of the style you want, or tell us to surprise you — either way, you could be the next
      face on this page.
    </p>
    <a
      href="https://app.podium.co.ke/book/BFRPL1313"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-7 inline-block rounded-full bg-gradient-to-r from-gold-500 to-gold-300 px-8 py-3.5 text-sm font-semibold text-ink shadow-lg shadow-gold-900/40 transition-transform hover:scale-105"
    >
      Book Your Session
    </a>
  </section>
</Layout>
